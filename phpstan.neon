parameters:
    level: 6
    paths:
        - includes
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan-constants.php
    excludePaths:
        - includes/class-cli.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Array value types — WordPress arrays are loosely typed.
        - '#no value type specified in iterable type array#'

        # Write-only $settings — stored for subclass/runtime access.
        - '#is never read, only written#'

        # Untyped hook params — WordPress actions/filters pass mixed types.
        - '#with no type specified#'

        # Defensive isset/??/empty on WP_Post — guards against edge cases.
        - '#in isset\(\) is not nullable#'
        - '#on left side of \?\? is not nullable#'
        - '#in empty\(\) always exists and is not falsy#'
        - '#Cannot access offset .* on WP_Post#'

        # Always-true comparisons in defensive code.
        - '#is always true#'

        # Unused class constants — used externally or reserved for future.
        - '#is unused#'

        # Optional WooCommerce dependency.
        - '#Function get_woocommerce_currency not found#'
