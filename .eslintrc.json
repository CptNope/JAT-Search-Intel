{
  "env": {
    "browser": true,
    "jquery": true,
    "es6": true
  },
  "globals": {
    "wp": "readonly",
    "ajaxurl": "readonly",
    "searchIntel": "readonly",
    "tinymce": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-console": "warn",
    "semi": ["error", "always"],
    "eqeqeq": "warn"
  }
}
