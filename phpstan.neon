parameters:
    level: 6
    paths:
        - includes
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan-constants.php
    ignoreErrors:
        - '#Function [a-zA-Z_]+ not found#'
        - '#Class [a-zA-Z_\\\\]+ extends unknown class#'
        - '#no value type specified in iterable type array#'
        - '#has parameter \$[a-z_]+ with no type specified#'
        - '#Right side of && is always true#'
        - '#is always true#'
        - '#Else branch is unreachable#'
        - '#in isset\(\) is not nullable#'
        - '#on left side of \?\? is not nullable#'
        - '#Cannot access offset .* on WP_Post#'
        - '#is never read, only written#'
